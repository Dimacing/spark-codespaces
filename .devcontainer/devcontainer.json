{
  "name": "Spark 3.5 для курса",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": { "version": "17" }
  },
  "postCreateCommand": "pip install --no-cache-dir pyspark==3.5.9",
  "forwardPorts": [4040],
  "portsAttributes": {
    "4040": { "label": "Spark UI", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
